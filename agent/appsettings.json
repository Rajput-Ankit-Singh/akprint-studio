{
  "CyberPrintAgent": {
    "ApiBaseUrl": "https://replace-with-your-backend.example/",
    "AgentId": "replace-with-enrolled-agent-id",
    "ShopId": "replace-with-shop-id",
    "EnrollmentTokenEnvironmentVariable": "CYBERPRINT_AGENT_ENROLLMENT_TOKEN",
    "JournalDirectory": "C:\\ProgramData\\CyberPrintPay\\journal",
    "WorkingDirectory": "C:\\ProgramData\\CyberPrintPay\\work",
    "LibreOfficePath": "C:\\Program Files\\LibreOffice\\program\\soffice.exe",
    "AllowedPrinterName": "replace-with-installed-printer-name",
    "HeartbeatSeconds": 45,
    "ClaimPollSeconds": 15,
    "HttpTimeoutSeconds": 30,
    "ConversionTimeoutSeconds": 120,
    "MaxDownloadMegabytes": 100
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.Hosting.Lifetime": "Information" }
  }
}
